      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum_over_time(max(nextdns_device_queries{name=\"$device\"})[$__range:5m])",
          "refId": "A",
          "range": false,
          "instant": true
